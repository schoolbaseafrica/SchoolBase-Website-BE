NODE_ENV=production
PORT=3008
APP_NAME=SchoolBase Website
API_PREFIX=api
API_VERSION=v1

FRONTEND_URL=https://website.example.com
CORS_ORIGINS=https://website.example.com

DB_HOST=postgres
DB_PORT=5432
DB_NAME=schoolbase_website
